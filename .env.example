# ── 数据库 ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=model_gateway
DB_POOL_MIN=5
DB_POOL_MAX=20

# ── 加密 ──────────────────────────────────────────────────────
# 32 字节 Base64，用于加密上游 API Key
ENCRYPT_SECRET_KEY=base64_encoded_32bytes_key_here

# ── 并发控制 ──────────────────────────────────────────────────
GLOBAL_MAX_CONCURRENCY=200
KEY_MAX_CONCURRENCY=20

# ── 管理端鉴权 ────────────────────────────────────────────────
ADMIN_TOKEN=change_me_to_a_strong_token

# ── 服务配置 ──────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── HTTPS / SSL ───────────────────────────────────────────────
# 启用 HTTPS（启用后自动生成自签名证书，需系统已安装 openssl）
SSL_ENABLED=false
# 证书存放目录及文件名
SSL_CERT_DIR=certs
SSL_CERT_FILE=cert.pem
SSL_KEY_FILE=key.pem
